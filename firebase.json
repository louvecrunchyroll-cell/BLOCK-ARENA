{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "FIREBASE_SETUP.md",
      "functions/**",
      "cloudflare-worker/**",
      ".*",
      "node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/tetris_connexion.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ]
}
